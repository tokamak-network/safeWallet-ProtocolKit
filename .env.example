# RPC URL for the network (e.g., Ethereum mainnet, Goerli, etc.)
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Safe Wallet Address
SAFE_ADDRESS=0x1234567890123456789012345678901234567890

# EIP-1271 Contract Address (already deployed and added as Safe owner)
EIP1271_CONTRACT_ADDRESS=0x0987654321098765432109876543210987654321

# Private key of the EIP-1271 contract owner (who can sign on behalf of the contract)
CONTRACT_OWNER_PRIVATE_KEY=your_contract_owner_private_key_here
CONTRACT_OWNER_PRIVATE_KEY2=your_contract_owner_private_key_here

# Chain ID (1 for mainnet, 5 for Goerli, etc.)
CHAIN_ID=1