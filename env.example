# RPC 설정
RPC_URL=http://localhost:8545

# 컨트랙트 주소들
SAFE_WALLET_ADDRESS=0x...
DAO_CONTRACT_ADDRESS=0x...
MULTISIG_WALLET_ADDRESS=0x...

# DAOContract는 이미 SafeWallet에 등록되어 있고, DAOContract의 Owner는 MultiSigWalletContract
# 따라서 DAO_PRIVATE_KEY는 필요하지 않음

# MultiSigWallet 서명자들의 Private Key (2명)
MULTISIG_SIGNER1_PRIVATE_KEY=0x...
MULTISIG_SIGNER2_PRIVATE_KEY=0x...

# SafeWallet의 다른 서명자들의 Private Key (Signer1, Signer3)
SAFE_SIGNER1_PRIVATE_KEY=0x...
SAFE_SIGNER3_PRIVATE_KEY=0x...

# 테스트용 설정 (선택사항)
TEST_TO_ADDRESS=0x...
TEST_VALUE=0
TEST_DATA=0x
TEST_SAFE_TRANSACTION=true
TEST_TX_HASH=0x34148392eddee2686a39b6da312a95afdbf953bef85122e5b0c73f3b624cba8f
