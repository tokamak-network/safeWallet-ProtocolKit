# RPC 설정
RPC_URL=http://localhost:8545

# 컨트랙트 주소들
SAFE_WALLET_ADDRESS=0x...
DAO_CONTRACT_ADDRESS=0x...
MULTISIG_WALLET_ADDRESS=0x...

# DAOContract Private Key (간단한 테스트용)
DAO_PRIVATE_KEY=0x...

# MultiSigWallet 서명자들의 Private Key
MULTISIG_SIGNER1_PRIVATE_KEY=0x...
MULTISIG_SIGNER2_PRIVATE_KEY=0x...
MULTISIG_SIGNER3_PRIVATE_KEY=0x...

# SafeWallet의 다른 서명자들의 Private Key (Signer1, Signer3)
SAFE_SIGNER1_PRIVATE_KEY=0x...
SAFE_SIGNER3_PRIVATE_KEY=0x...

# 테스트용 설정 (선택사항)
TEST_TO_ADDRESS=0x...
TEST_VALUE=0
TEST_DATA=0x
TEST_SAFE_TRANSACTION=true
TEST_TX_HASH=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef
